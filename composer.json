{
    "name": "wodzy/cakephp-disposable-email",
    "description": "CakePHP plugin that blocks disposable (throwaway) email addresses, powered by wodzy/disposable-email.",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "cakephp-plugin",
        "email",
        "disposable-email",
        "blacklist",
        "validation"
    ],
    "homepage": "https://github.com/wodzy/cakephp-disposable-email",
    "license": "MIT",
    "authors": [
        {
            "name": "Walid Oukaci",
            "email": "contact@oukaci.com",
            "homepage": "https://github.com/wodzy",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/wodzy/cakephp-disposable-email/issues",
        "source": "https://github.com/wodzy/cakephp-disposable-email"
    },
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.1",
        "wodzy/disposable-email": "^1.0"
    },
    "require-dev": {
        "cakedc/cakephp-phpstan": "^4",
        "cakephp/cakephp-codesniffer": "^5.2",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2",
        "phpunit/phpunit": "^10.5.5 || ^11.1.3"
    },
    "autoload": {
        "psr-4": {
            "CakeDisposableEmail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CakeDisposableEmail\\Test\\": "tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "check": [
            "@cs-check",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable"
}
